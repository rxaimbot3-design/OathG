{
  "name": "ultimate-discord-ai-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Discord AI Bot with Zero-Trust Security, Ghost Bypass Protection, and Live Sentiment AI",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development UV_THREADPOOL_SIZE=128 tsx server.ts",
    "build:worker": "npx esbuild src/EngineWorker.ts --bundle --platform=node --format=cjs --packages=external --outfile=server-build/EngineWorker.cjs",
    "build:native": "node-gyp rebuild",
    "build": "npm run build:native && npm run build:worker && cross-env NODE_OPTIONS=--max-old-space-size=450 npx vite build && cross-env NODE_OPTIONS=--max-old-space-size=450 npx esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=server-build/server.mjs",
    "start": "cross-env NODE_ENV=production node server-build/server.mjs",
    "clean": "rm -rf dist server-build server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/security.test.ts tests/pipeline.test.ts tests/backup.test.ts tests/cpp-engine.test.ts",
    "test:integration": "vitest run tests/dashboard.test.ts",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:fuzz": "vitest run tests/fuzz.test.ts",
    "test:load": "vitest run tests/load.test.ts",
    "test:stress": "vitest run tests/stress.test.ts",
    "test:regression": "vitest run tests/regression.test.ts",
    "test:cpp": "vitest run tests/cpp-engine.test.ts",
    "test:security": "vitest run tests/security.test.ts tests/pipeline.test.ts",
    "benchmark": "vitest run tests/load.test.ts tests/stress.test.ts",
    "docs:build": "node scripts/build-docs.js",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit",
    "security:scan": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.0.0",
    "supertest": "^6.3.4",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/redis": "^4.0.10",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "opusscript": "^0.1.1",
    "play-dl": "^1.9.7",
    "prism-media": "^1.3.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^4.7.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "tweetnacl": "^1.0.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "node-addon-api": "^7.1.1"
  }
}
