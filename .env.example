# ====================================================================
# ULTIMATE DISCORD AI BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
#
# CRITICAL NOTICE FOR DISCORD BOT RUNTIME:
# Under the "Bot" section in the Discord Developer Portal (https://discord.com/developers/applications),
# you MUST manually enable the following Privileged Gateway Intents:
# 1. GUILD MEMBERS INTENT (Required for verification, role auto-reverts, and member events)
# 2. MESSAGE CONTENT INTENT (Required for scanning messages, AI moderation, and prefix commands)
# If these intents are not enabled, the bot will CRASH immediately on startup!
#
# ====================================================================

# 1. Discord Bot Credentials (Required)
# Retrieve from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_CLIENT_ID="your_discord_client_id_here"
DISCORD_GUILD_ID="your_optional_discord_guild_id_here"

# 2. Server Owner & Permission Administration (Required for Admin Controls)
# Discord User ID of the primary bot owner (used by OwnerLock security system)
DISCORD_OWNER_ID="1211700196459675658"
# Comma-separated list of additional allowed owner IDs
ALLOWED_OWNERS=""

# 3. Google Gemini AI API Configuration (Required for AI Features)
# Obtain key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key_here"

# 4. Web Application Server Configuration
# PORT can be configured dynamically (e.g. for Render, Railway, or local testing)
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
ADMIN_SECRET="63c4ef797f8e954336b97efd2699d54b5de6f223d1f1bd6ebcea23c7613894fc"

# 5. GitHub Synchronization & Webhook Credentials (Optional)
# Personal Access Token (PAT) with repo scope for automated GitHub repo pushes
GITHUB_TOKEN=""
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret_here"

# 6. Redis Configuration (Optional but Recommended)
# Redis is used for caching, sessions, and rate limiting
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# 7. MongoDB Configuration (Optional)
# MongoDB is used for persistent data storage
MONGODB_URI="mongodb://localhost:27017/ultimate-discord-bot"

# 8. Performance Tuning
# Thread pool size for Node.js libuv (default: 4, recommended: 128)
UV_THREADPOOL_SIZE=128
# Max heap size for Node.js (default: 450MB)
NODE_OPTIONS="--max-old-space-size=450"

# 9. Security Configuration
# Enable strict mode for production (disables inline scripts)
STRICT_CSP=false
# Allowed origins for CORS (comma-separated, leave empty for config-based)
ALLOWED_ORIGIN=""
# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# 10. Discord Intents Configuration
# These must also be enabled in Discord Developer Portal
INTENTS_GUILDS=true
INTENTS_GUILD_MEMBERS=true
INTENTS_GUILD_MESSAGES=true
INTENTS_MESSAGE_CONTENT=true
INTENTS_GUILD_VOICE_STATES=true

# 11. Feature Flags
# Disable features that are not needed
DISABLE_MUSIC=false
DISABLE_AI=false
DISABLE_GITHUB=false
DISABLE_ECONOMY=false

# 12. Backup Configuration
BACKUP_FREQUENCY=6h
BACKUP_RETENTION_DAYS=30
BACKUP_PATH="./backups"

# 13. Logging Configuration
LOG_LEVEL="info"
LOG_PATH="./logs"

# 14. Premium License (Optional)
PREMIUM_LICENSE_KEY=""

# 15. Proxy Configuration (Optional)
HTTP_PROXY=""
HTTPS_PROXY=""
